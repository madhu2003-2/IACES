# Flask API
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false

# Paths are relative to C:\IACES unless absolute paths are supplied.
FITPREDICT_MODEL_PATH=models/calorie_prediction_pipeline.joblib
FITPREDICT_API_URL=http://127.0.0.1:5000

# Workout history is optional. SQLite needs no server; its file is created automatically.
DATABASE_ENABLED=false
DATABASE_BACKEND=sqlite
DATABASE_PATH=database/fitpredict_history.sqlite3

# To use MySQL instead, set DATABASE_BACKEND=mysql, run database/schema.sql,
# and provide the server credentials below.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=fitpredict_user
DB_PASSWORD=change-me
DB_NAME=fitpredict_ai
